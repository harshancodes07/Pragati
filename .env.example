# NVIDIA NIM — the single external dependency and the single secret.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model IDs. Locked by scripts/benchmark_nim.py at Block 1 — do not guess these.
NVIDIA_MODEL=
# Optional per-task overrides. Leave blank to use NVIDIA_MODEL for everything.
NVIDIA_MODEL_TUTOR=
NVIDIA_MODEL_STRUCTURED=
# Retried against if the primary model 404s or rate-limits mid-demo.
NVIDIA_MODEL_BACKUP=

# Vision model used for OCR of textbook photos. A "parse" family model
# (nemotron-parse, nemoretriever-parse) is detected by name in provider.py and
# takes a different request shape — no text prompt, transcription mode chosen
# via `tools`, response arrives as a tool call. ~3s on a dense NCERT page vs
# ~35s for a general vision-chat model. Re-check with scripts/benchmark_nim.py.
NVIDIA_MODEL_VISION=nvidia/nemotron-parse

# Embeddings. NeMo Retriever models are asymmetric (query vs passage prefixes).
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBED_DIM=2048

# Retrieval / grounding guardrail. Calibrated at Block 3, then frozen.
GROUNDING_THRESHOLD=0.15
RETRIEVAL_TOP_K=6

# Chunking
CHUNK_SIZE=120
CHUNK_OVERLAP=25

# Sarvam AI — voice only (speech-to-text, text-to-speech, transliteration).
# A separate vendor because no NVIDIA model this key reaches does speech, and
# Riva's voices don't cover Tamil. Leave blank to ship without voice: the mic
# and speaker buttons simply don't render.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
# Voice for every language. bulbul:v3 speakers: aditya, ritu, ashutosh, priya,
# neha, rahul, pooja, rohan, simran, kavya, amit, dev, and more — confirm by ear.
SARVAM_TTS_SPEAKER=priya

# Local paths
DATA_DIR=./data
DB_PATH=./data/pragati.db

# CORS — comma-separated origins allowed to call the API. Add your deployed
# frontend's URL here in production (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Sign-In. Create a Web application OAuth client at
# console.cloud.google.com (APIs & Services > Credentials) and add both your
# deployed frontend URL and http://localhost:5173 as Authorized JavaScript
# origins. This same Client ID also goes in the frontend as VITE_GOOGLE_CLIENT_ID
# — it isn't secret, it's shipped to the browser either way.
GOOGLE_CLIENT_ID=

# Signs the app's own session token issued after Google verifies a sign-in.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be set in production — login is refused without it.
JWT_SECRET=
JWT_EXPIRY_HOURS=168
