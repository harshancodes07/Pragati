# Only needed in production, where the frontend and backend are deployed
# separately. Set this to your Railway backend's public URL, no trailing
# slash (e.g. https://pragati-production.up.railway.app). Leave unset for
# local dev — Vite's proxy in vite.config.js handles /api locally.
VITE_API_URL=

# Google Sign-In client ID (the same one set as GOOGLE_CLIENT_ID on the
# backend). Not a secret — it's sent to the browser either way — but it does
# need to match, and its OAuth client must list this site's origin under
# Authorized JavaScript origins in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
